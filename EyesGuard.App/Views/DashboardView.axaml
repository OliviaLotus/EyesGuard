<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EyesGuard.App.ViewModels"
             x:Class="EyesGuard.App.Views.DashboardView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="18">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Text="下午好，护眼达人" Classes="page-title" />
        <TextBlock Grid.Row="1" Text="今天也要好好保护眼睛" Classes="muted" Margin="0,5,0,0" />
        <ToggleSwitch Grid.Column="1" Grid.RowSpan="2"
                      IsChecked="{Binding Settings.IsProtectionEnabled, Mode=TwoWay}"
                      OnContent="护眼已开启" OffContent="护眼已暂停"
                      VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="card">
          <Grid ColumnDefinitions="1.1*,*" ColumnSpacing="22">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
              <TextBlock Text="今日用眼概览" Classes="section-title" HorizontalAlignment="Left" />
              <Panel Width="190" Height="190">
                <Ellipse Margin="10" Stroke="{DynamicResource EyeSurfaceSubtleBrush}" StrokeThickness="14" />
                <Ellipse Margin="10" Stroke="{DynamicResource EyePrimaryBrush}" StrokeThickness="14"
                         StrokeDashArray="8,2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="{Binding Dashboard.TodayUsageText}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="今日总用眼时长" Classes="muted" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
              <TextBlock Text="建议每日不超过 6 小时" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="18">
              <StackPanel><TextBlock Text="连续最长用眼" Classes="muted"/><TextBlock Text="{Binding Dashboard.LongestSessionText}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
              <StackPanel><TextBlock Text="休息次数" Classes="muted"/><TextBlock Text="{Binding Dashboard.BreakCount, StringFormat='{}{0}次'}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
              <StackPanel><TextBlock Text="休息完成率" Classes="muted"/><TextBlock Text="{Binding Dashboard.CompletionRate, StringFormat='{}{0}%'}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
              <StackPanel><TextBlock Text="夜间用眼时长" Classes="muted"/><TextBlock Text="{Binding Dashboard.NightUsageText}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="15">
            <TextBlock Text="下次休息" Classes="section-title" />
            <Border Width="140" Height="140" CornerRadius="70" BorderThickness="12"
                    BorderBrush="{DynamicResource EyePrimarySoftBrush}" HorizontalAlignment="Center">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding BreakControl.NextBreakText}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="后提醒休息" Classes="muted" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <ProgressBar Value="{Binding BreakControl.WorkProgress}" Minimum="0" Maximum="100" Height="6" />
            <Button Content="立即休息" Classes="secondary" Command="{Binding BreakControl.StartBreakCommand}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="15">
            <TextBlock Text="护眼状态" Classes="section-title" />
            <Border Width="88" Height="88" CornerRadius="44" Background="#E1F7EC" HorizontalAlignment="Center">
              <TextBlock Text="✓" FontSize="48" Foreground="{DynamicResource EyeSuccessBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding BreakControl.PhaseText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="继续保持良好的用眼习惯" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
            <Separator />
            <TextBlock Text="护眼健康评分" Classes="muted" />
            <TextBlock Text="{Binding Dashboard.HealthScore, StringFormat='{}{0}分'}" Classes="metric" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="1.4*,*" ColumnSpacing="14">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="护眼建议" Classes="section-title" />
            <TextBlock Text="●  每 20 分钟休息 20 秒，远眺约 6 米外物体" />
            <TextBlock Text="●  减少夜间用眼时长，建议 23:00 后开启暖色模式" />
            <TextBlock Text="●  保持正确坐姿，屏幕距离建议大于 50 厘米" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="快捷开关" Classes="section-title" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <ToggleSwitch Grid.Row="0" Grid.Column="0" Content="护眼模式" IsChecked="{Binding BlueLight.BlueLightEnabled, Mode=TwoWay}" />
              <Button Grid.Row="0" Grid.Column="1" Content="休息提醒" Classes="quiet" Command="{Binding BreakControl.StartBreakCommand}" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" Classes="muted" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
