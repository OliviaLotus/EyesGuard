<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EyesGuard.App.ViewModels"
        xmlns:views="using:EyesGuard.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="EyesGuard.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="护眼助手"
        Width="980" Height="650"
        MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="188,*">
        <Border Grid.Column="0"
                Background="{DynamicResource EyeSurfaceBrush}"
                BorderBrush="{DynamicResource EyeBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="14,20">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,24">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource EyePrimaryBrush}">
                        <TextBlock Text="◉" Foreground="White" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="护眼助手" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>

                <ListBox Grid.Row="1" Classes="sidebar" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">
                    <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="⌂" Width="20"/><TextBlock Text="首页"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="◉" Width="20"/><TextBlock Text="模式"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="▥" Width="20"/><TextBlock Text="统计报告"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="◷" Width="20"/><TextBlock Text="提醒设置"/></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="⚙" Width="20"/><TextBlock Text="设置"/></StackPanel></ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Spacing="10">
                    <Border Background="{DynamicResource EyeSurfaceSubtleBrush}" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="当前方案" Classes="muted" FontSize="11" />
                            <TextBlock Text="{Binding SceneManagement.ActiveModeName}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="本地数据已保护" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Carousel Grid.Column="1"
                  SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">
            <views:DashboardView />
            <views:ModeView />
            <views:ReportsView />
            <views:ReminderSettingsView />
            <views:SettingsView />
        </Carousel>
    </Grid>
</Window>
